{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": false,
		"strict": true,
		"moduleResolution": "bundler"
	},
	"exclude": [
		"build",
		"data",
		"data-test-*"
	]
	// Aliases are package subpath imports (#lib/*, #services/*, #components/*
	// in package.json "imports") — $lib was removed in SvelteKit 3.
}
