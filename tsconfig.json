{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": false,
		"strict": true,
		"moduleResolution": "bundler"
	}
	// Path aliases ($lib, $services, $components) were replaced with package
	// subpath imports (#lib/*, #services/*, #components/*) — see package.json
	// "imports". $lib itself is removed in SvelteKit 3.
}
