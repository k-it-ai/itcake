# ITCake Configuration
# Copy to .env and fill in values

# Database path (relative to project root)
DATABASE_PATH=data/itcake.db

# Data directory (for PDFs, uploads)
DATA_DIR=data

# Host and port
HOST=127.0.0.1
PORT=3000

# Public origin (required in production for CSRF protection)
# Set to the URL users will access, e.g. https://invoices.example.com
# ORIGIN=https://invoices.example.com

# Set to 'production' to enable secure cookies (requires HTTPS)
NODE_ENV=development

# Session token HMAC secret (REQUIRED in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without this, session tokens use plain SHA256 — a DB leak would allow session forgery.
SESSION_SECRET=

# Set to 'true' when running without sandbox (disables Chromium sandbox)
PUPPETEER_NO_SANDBOX=false
