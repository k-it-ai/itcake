# ITCake Configuration
# Copy to .env and fill in values

# Database path (relative to project root)
DATABASE_PATH=data/itcake.db

# Data directory (for PDFs, uploads)
DATA_DIR=data

# Host and port
HOST=127.0.0.1
PORT=3000

# Public origin (required in production for CSRF protection)
# Set to the URL users will access, e.g. https://invoices.example.com
# ORIGIN=https://invoices.example.com

# Set to 'production' to enable secure cookies (requires HTTPS)
NODE_ENV=development

# Session token HMAC secret (REQUIRED in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without this, session tokens use plain SHA256 — a DB leak would allow session forgery.
SESSION_SECRET=

# Set to 'true' when running without sandbox (disables Chromium sandbox)
PUPPETEER_NO_SANDBOX=false

# Log level for the NDJSON logger: debug | info | warn | error
# Defaults to 'debug' in development and 'info' in production.
# LOG_LEVEL=info

# When ITCake runs behind a reverse proxy (Caddy, nginx, Cloudflare),
# set this to the header that carries the real client IP — e.g.
# X-Forwarded-For. Required for accurate per-IP rate limiting.
# Only set when HOST is bound to loopback (127.0.0.1) — startup will
# refuse to boot otherwise, since direct connections could spoof the
# header and bypass rate limits.
# ADDRESS_HEADER=X-Forwarded-For

# Acknowledge that the port is reachable only through a trusted reverse
# proxy (e.g. a container network that is itself the trust boundary) and
# therefore ADDRESS_HEADER may be used with a non-loopback HOST.
# TRUST_PROXY=true
