<!DOCTYPE html>
<html lang="<%= language %>">
<head>
<meta charset="utf-8">
<title><%= title %></title>
<style>
<%- normalizeCss %>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 10pt; color: #333; background: white; }
@page { size: A4; margin: 0; }
.page { width: 210mm; min-height: 297mm; padding: 20mm; position: relative; page-break-after: always; }
@media print { .page { margin: 0; } }
<%- templateCss %>
</style>
</head>
<body>
<%- body %>
</body>
</html>
