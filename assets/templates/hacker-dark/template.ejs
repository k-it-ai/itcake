<div class="page" style="<%- optionsAsCssVariables(templateOptions) %>">

	<!-- Header -->
	<div class="hd-header">
		<div class="hd-header-left">
			<% if (seller.logoUrl) { %>
				<img src="<%= seller.logoUrl %>" alt="Logo" class="hd-logo">
			<% } %>
			<div>
				<h1 class="hd-doc-title"><%= type === 'proposal' ? t('proposal') : (isCreditNote ? t('creditNote') : t('invoice')) %></h1>
				<p class="hd-doc-id"><%= documentId %></p>
			</div>
		</div>
		<div class="hd-seller-info">
			<strong><%= seller.name %></strong><br>
			<%- nl2br(joinAddress(seller.address, language)) %>
			<% if (seller.taxNumber) { %><br><%= t('taxNumber') %>: <%= seller.taxNumber %><% } %>
			<% if (seller.vatNumber) { %><br><%= t('vatNumber') %>: <%= seller.vatNumber %><% } %>
			<% if (seller.registrationNumber) { %><br><%= t('registrationNumber') %>: <%= seller.registrationNumber %><% } %>
			<% if (seller.phone) { %><br><%= seller.phone %><% } %>
			<% if (seller.email) { %><br><%= seller.email %><% } %>
		</div>
	</div>

	<!-- Buyer + Dates -->
	<div class="hd-meta">
		<div class="hd-buyer" style="font-size: 9pt;">
			<p class="hd-buyer-label"><%= t('billTo') %></p>
			<strong><%= buyer.name %></strong><br>
			<%- nl2br(joinAddress(buyer.address, language)) %>
			<% if (buyer.vatNumber) { %><br><%= t('vatNumber') %>: <%= buyer.vatNumber %><% } %>
		</div>
		<div class="hd-dates" style="font-size: 9pt;">
			<table>
				<tr><td><%= getDocumentDateLabel() %></td><td><%= formatDate(issueDate) %></td></tr>
				<% if (dueDate) { %>
				<tr><td><%= t('dueDate') %></td><td><%= formatDate(dueDate) %></td></tr>
				<% } %>
				<% if (validUntil) { %>
				<tr><td><%= t('validUntil') %></td><td><%= formatDate(validUntil) %></td></tr>
				<% } %>
				</table>
		</div>
	</div>

	<% if (introText) { %>
	<div class="hd-intro"><%- nl2br(introText) %></div>
	<% } %>

	<!-- Items Table -->
	<table class="hd-items">
		<thead>
			<tr>
				<th class="text-left"><%= t('description') %></th>
				<th class="text-right"><%= t('qty') %></th>
				<th class="text-left"><%= t('unit') %></th>
				<th class="text-right"><%= t('price') %></th>
				<% if (!kleinunternehmer) { %><th class="text-right"><%= t('tax') %></th><% } %>
				<th class="text-right"><%= t('amount') %></th>
			</tr>
		</thead>
		<tbody>
			<% function renderItems(items, depth) { %>
				<% items.forEach(function(item, idx) { %>
					<% if (item.items && item.items.length > 0) { %>
						<tr class="item-group">
							<td colspan="<%= kleinunternehmer ? 5 : 6 %>" style="padding-left: <%= depth * 16 %>px;"><strong><%= item.name || item.description %></strong></td>
						</tr>
						<% if (item.name && item.description) { %>
						<tr class="item-row item-row--description"><td class="description-column" colspan="4"><div class="item-description"><%- nl2br(item.description) %></div></td></tr>
						<% } %>
						<% renderItems(item.items, depth + 1); %>
					<% } else { %>
						<tr>
							<td class="text-left" style="padding-left: <%= depth * 16 %>px;"><strong><%= item.name || item.description %></strong></td>
							<td class="text-right"><%= formatQuantity(item.quantity) %></td>
							<td class="text-left"><%= item.unit %></td>
							<td class="text-right"><%= formatMoney(item.unitPrice) %></td>
							<% if (!kleinunternehmer) { %><td class="text-right"><%= item.taxRate %>%</td><% } %>
							<td class="text-right"><%= formatMoney(computeItemSubtotal(item)) %></td>
						</tr>
						<% if (item.name && item.description) { %>
						<tr class="item-row item-row--description"><td class="description-column" colspan="4"><div class="item-description"><%- nl2br(item.description) %></div></td></tr>
						<% } %>
					<% } %>
				<% }); %>
			<% } %>
			<% renderItems(items, 0); %>
		</tbody>
	</table>

	<!-- Totals -->
	<div class="hd-totals-wrap">
		<table class="hd-totals">
			<tr><td><%= t('subtotal') %></td><td><%= formatMoney(totals.subtotal) %></td></tr>
			<% if (totals.discountAmount > 0) { %>
			<tr class="discount"><td><%= t('discount') %></td><td>-<%= formatMoney(totals.discountAmount) %></td></tr>
			<% } %>
			<% if (!kleinunternehmer) { %>
			<% totals.taxSubtotals.forEach(function(ts) { %>
			<tr><td><%= t('tax') %> <%= ts.rate %>%</td><td><%= formatMoney(ts.taxAmount) %></td></tr>
			<% }); %>
			<% } %>
			<% if (kleinunternehmerNotice) { %>
			<tr><td colspan="2" style="font-size: 8pt; color: #888;"><%= kleinunternehmerNotice %></td></tr>
			<% } %>
			<tr class="total-row">
				<td><%= t('total') %></td>
				<td><%= formatMoney(totals.total) %></td>
			</tr>
		</table>
	</div>

	<!-- Bank details + Notes + Footer -->
	<% if (seller.bankIban || notes || footerText || (typeof paymentQrCodeSvg !== 'undefined' && paymentQrCodeSvg)) { %>
	<div class="hd-payment-footer">
		<div>
			<% if (seller.bankIban && type === 'invoice') { %>
			<div class="hd-bank">
				<%= t('paymentInstruction', { days: String(paymentTermDays) }) %>
				<div style="margin-top: 8px;">
					<strong><%= seller.bankAccount || seller.name %></strong><br>
					<%= seller.bankIban %>
					<% if (seller.bankSwift) { %><br><%= seller.bankSwift %><% } %>
				</div>
			</div>
			<% } else if (seller.bankIban) { %>
			<div class="hd-bank">
				<strong><%= t('bankDetails') || 'Bank Details' %></strong><br>
				<%= seller.bankName %> | IBAN: <%= seller.bankIban %>
				<% if (seller.bankSwift) { %> | BIC: <%= seller.bankSwift %><% } %>
			</div>
			<% } %>
			<% if (notes) { %>
			<div class="hd-notes"><%- nl2br(notes) %></div>
			<% } %>
			<% if (footerText) { %>
			<div class="hd-footer-text"><%- nl2br(footerText) %></div>
			<% } %>
		</div>
		<% if (typeof paymentQrCodeSvg !== 'undefined' && paymentQrCodeSvg) { %>
		<div class="qr-code"><img src="<%= paymentQrCodeSvg %>" alt="Payment QR"></div>
		<% } %>
	</div>
	<% } %>

</div>
