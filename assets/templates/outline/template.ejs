<div class="page" style="<%- optionsAsCssVariables(templateOptions) %>">

  <%/* ---- Header ---- */%>
  <div class="header">
    <div class="header-left">
      <% if (seller.logoUrl) { %>
        <img src="<%= seller.logoUrl %>" alt="Logo" class="header-logo">
      <% } %>
      <h1 class="header-title"><%= type === 'proposal' ? t('proposal') : (isCreditNote ? t('creditNote') : t('invoice')) %></h1>
    </div>
    <div class="header-right">
      <div class="header-doc-id"><%= getDocumentIdLabel() %>: <%= documentId %></div>
    </div>
  </div>

  <%/* ---- Seller & Buyer ---- */%>
  <div class="parties-row">
    <div class="party-box">
      <div class="party-label"><%= t('from') %></div>
      <div class="party-name"><%= seller.name %></div>
      <div class="party-details">
        <%- nl2br(joinAddress(seller.address, language)) %>
        <% if (seller.taxNumber) { %><br><%= t('taxNumber') %>: <%= seller.taxNumber %><% } %>
        <% if (seller.vatNumber) { %><br><%= t('vatNumber') %>: <%= seller.vatNumber %><% } %>
        <% if (seller.registrationNumber) { %><br><%= t('registrationNumber') %>: <%= seller.registrationNumber %><% } %>
        <% if (seller.phone) { %><br><%= seller.phone %><% } %>
        <% if (seller.email) { %><br><%= seller.email %><% } %>
      </div>
    </div>
    <div class="party-box">
      <div class="party-label"><%= t('billTo') %></div>
      <div class="party-name"><%= buyer.name %></div>
      <div class="party-details">
        <%- nl2br(joinAddress(buyer.address, language)) %>
        <% if (buyer.vatNumber) { %><br><%= t('vatNumber') %>: <%= buyer.vatNumber %><% } %>
      </div>
    </div>
  </div>

  <%/* ---- Dates ---- */%>
  <div class="dates-box">
    <div class="date-item">
      <span class="date-label"><%= getDocumentDateLabel() %>:</span>
      <span class="date-value"><%= formatDate(issueDate) %></span>
    </div>
    <% if (type === 'invoice' && dueDate) { %>
      <div class="date-item">
        <span class="date-label"><%= t('dueDate') %>:</span>
        <span class="date-value"><%= formatDate(dueDate) %></span>
      </div>
    <% } %>
    <% if (type === 'proposal' && validUntil) { %>
      <div class="date-item">
        <span class="date-label"><%= t('validUntil') %>:</span>
        <span class="date-value"><%= formatDate(validUntil) %></span>
      </div>
    <% } %>
  </div>

  <%/* ---- Intro Text ---- */%>
  <% if (introText) { %>
    <div class="intro-text"><%- nl2br(introText) %></div>
  <% } %>

  <%/* ---- Items Table ---- */%>
  <table class="items-table">
    <thead>
      <tr>
        <th><%= t('description') %></th>
        <th class="num"><%= t('quantity') %></th>
        <th><%= t('unit') %></th>
        <th class="num"><%= t('unitPrice') %></th>
        <% if (!kleinunternehmer) { %><th class="num"><%= t('tax') %></th><% } %>
        <th class="num"><%= t('amount') %></th>
      </tr>
    </thead>
    <tbody>
      <% function renderItems(items, depth) { %>
        <% items.forEach(function(item) { %>
          <% if (item.items && item.items.length > 0) { %>
            <tr class="group-header">
              <td colspan="<%= kleinunternehmer ? 5 : 6 %>" style="padding-left: <%= 3 + depth * 4 %>mm;"><strong><%= item.name || item.description %></strong></td>
            </tr>
            <% if (item.name && item.description) { %>
            <tr class="item-row item-row--description"><td class="description-column" colspan="4"><div class="item-description"><%- nl2br(item.description) %></div></td></tr>
            <% } %>
            <% renderItems(item.items, depth + 1); %>
          <% } else { %>
            <tr>
              <td style="padding-left: <%= 3 + depth * 4 %>mm;"><strong><%= item.name || item.description %></strong></td>
              <td class="num"><%= formatQuantity(item.quantity) %></td>
              <td><%= item.unit %></td>
              <td class="num"><%= formatMoney(item.unitPrice) %></td>
              <% if (!kleinunternehmer) { %><td class="num"><%= item.taxRate %>%</td><% } %>
              <td class="num"><%= formatMoney(computeItemSubtotal(item)) %></td>
            </tr>
            <% if (item.name && item.description) { %>
            <tr class="item-row item-row--description"><td class="description-column" colspan="4"><div class="item-description"><%- nl2br(item.description) %></div></td></tr>
            <% } %>
          <% } %>
        <% }); %>
      <% } %>
      <% renderItems(items, 0); %>
    </tbody>
  </table>

  <%/* ---- Totals ---- */%>
  <div class="totals-wrapper">
    <div class="totals-box">
      <table class="totals-table">
        <tr>
          <td><%= t('subtotal') %></td>
          <td><%= formatMoney(totals.subtotal) %></td>
        </tr>
        <% if (totals.discountAmount) { %>
          <tr class="discount">
            <td><%= t('discount') %></td>
            <td>&minus;<%= formatMoney(totals.discountAmount) %></td>
          </tr>
        <% } %>
        <% if (!kleinunternehmer) { %>
        <% totals.taxSubtotals.forEach(function(tax) { %>
          <tr>
            <td><%= t('tax') %> (<%= tax.rate %>%)</td>
            <td><%= formatMoney(tax.taxAmount) %></td>
          </tr>
        <% }); %>
        <% } %>
        <% if (kleinunternehmerNotice) { %>
        <tr><td colspan="2" style="font-size: 8pt; color: #888;"><%= kleinunternehmerNotice %></td></tr>
        <% } %>
        <tr class="total-row">
          <td><%= t('total') %></td>
          <td><%= formatMoney(totals.total) %> <%= currency %></td>
        </tr>
      </table>
    </div>
  </div>

  <%/* ---- Bank Details ---- */%>
  <% if (seller.bankIban && type === 'invoice') { %>
    <div class="bank-box">
      <div style="margin-bottom: 8px;"><%= t('paymentInstruction', { days: String(paymentTermDays) }) %></div>
      <strong><%= seller.bankAccount || seller.name %></strong><br>
      <%= seller.bankIban %>
      <% if (seller.bankSwift) { %><br><%= seller.bankSwift %><% } %>
    </div>
  <% } else if (seller.bankIban) { %>
    <div class="bank-box">
      <div class="bank-title"><%= t('bankDetails') %></div>
      <div class="bank-grid">
        <div>
          <div class="bank-label"><%= t('bankName') %></div>
          <div><%= seller.bankName %></div>
        </div>
        <div>
          <div class="bank-label"><%= t('iban') %></div>
          <div><%= seller.bankIban %></div>
        </div>
        <% if (seller.bankSwift) { %>
          <div>
            <div class="bank-label"><%= t('swift') %></div>
            <div><%= seller.bankSwift %></div>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>

  <%/* ---- Payment QR Code ---- */%>
  <% if (typeof paymentQrCodeSvg !== 'undefined' && paymentQrCodeSvg) { %>
    <div class="qr-section">
      <img src="<%= paymentQrCodeSvg %>" alt="Payment QR">
      <div class="qr-label"><%= t('paymentQrCode') %></div>
    </div>
  <% } %>

  <%/* ---- Notes ---- */%>
  <% if (notes) { %>
    <div class="notes-section">
      <div class="notes-label"><%= t('notes') %></div>
      <div class="notes-body"><%- nl2br(notes) %></div>
    </div>
  <% } %>

  <%/* ---- Footer ---- */%>
  <% if (footerText) { %>
    <div class="footer-text"><%- nl2br(footerText) %></div>
  <% } %>

</div>
