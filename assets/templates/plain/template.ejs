<div class="page">
	<!-- Header -->
	<div style="display: flex; justify-content: space-between; margin-bottom: 40px;">
		<div>
			<% if (seller.logoUrl) { %>
				<img src="<%= seller.logoUrl %>" alt="Logo" style="max-height: 60px; margin-bottom: 10px;">
			<% } %>
			<h1 style="font-size: 24px; font-weight: 700; color: #333; margin: 0;">
				<%= type === 'proposal' ? t('proposal') : (isCreditNote ? t('creditNote') : t('invoice')) %>
			</h1>
			<p style="font-size: 14px; color: #888; margin-top: 4px;"><%= documentId %></p>
		</div>
		<div style="text-align: right; font-size: 9pt; color: #666;">
			<strong><%= seller.name %></strong><br>
			<%- nl2br(joinAddress(seller.address, language)) %>
			<% if (seller.taxNumber) { %><br><%= t('taxNumber') %>: <%= seller.taxNumber %><% } %>
			<% if (seller.vatNumber) { %><br><%= t('vatNumber') %>: <%= seller.vatNumber %><% } %>
			<% if (seller.phone) { %><br><%= seller.phone %><% } %>
			<% if (seller.email) { %><br><%= seller.email %><% } %>
		</div>
	</div>

	<!-- Buyer + Dates -->
	<div style="display: flex; justify-content: space-between; margin-bottom: 30px;">
		<div style="font-size: 9pt;">
			<p style="color: #888; font-size: 8pt; text-transform: uppercase; margin-bottom: 4px;"><%= t('billTo') %></p>
			<strong><%= buyer.name %></strong><br>
			<%- nl2br(joinAddress(buyer.address, language)) %>
			<% if (buyer.vatNumber) { %><br><%= t('vatNumber') %>: <%= buyer.vatNumber %><% } %>
		</div>
		<div style="text-align: right; font-size: 9pt;">
			<table style="margin-left: auto; text-align: left;">
				<tr><td style="color: #888; padding-right: 12px;"><%= getDocumentDateLabel() %>:</td><td><%= formatDate(issueDate) %></td></tr>
				<% if (dueDate) { %>
				<tr><td style="color: #888; padding-right: 12px;"><%= t('dueDate') %>:</td><td><%= formatDate(dueDate) %></td></tr>
				<% } %>
				<% if (validUntil) { %>
				<tr><td style="color: #888; padding-right: 12px;"><%= t('validUntil') %>:</td><td><%= formatDate(validUntil) %></td></tr>
				<% } %>
				</table>
		</div>
	</div>

	<% if (introText) { %>
	<div style="margin-bottom: 20px; font-size: 9pt; line-height: 1.5;"><%- nl2br(introText) %></div>
	<% } %>

	<!-- Items Table -->
	<table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
		<thead>
			<tr style="border-bottom: 2px solid #333;">
				<th style="text-align: left; padding: 8px 4px; font-size: 8pt; text-transform: uppercase; color: #888;"><%= t('description') %></th>
				<th style="text-align: right; padding: 8px 4px; font-size: 8pt; text-transform: uppercase; color: #888;"><%= t('qty') %></th>
				<th style="text-align: left; padding: 8px 4px; font-size: 8pt; text-transform: uppercase; color: #888;"><%= t('unit') %></th>
				<th style="text-align: right; padding: 8px 4px; font-size: 8pt; text-transform: uppercase; color: #888;"><%= t('price') %></th>
				<% if (!kleinunternehmer) { %><th style="text-align: right; padding: 8px 4px; font-size: 8pt; text-transform: uppercase; color: #888;"><%= t('tax') %></th><% } %>
				<th style="text-align: right; padding: 8px 4px; font-size: 8pt; text-transform: uppercase; color: #888;"><%= t('amount') %></th>
			</tr>
		</thead>
		<tbody>
			<% function renderItems(items, depth) { %>
				<% items.forEach(function(item) { %>
					<% if (item.items && item.items.length > 0) { %>
						<tr>
							<td colspan="<%= kleinunternehmer ? 5 : 6 %>" style="padding: 8px 4px; font-weight: 600; padding-left: <%= depth * 16 %>px; border-bottom: 1px solid #eee;"><strong><%= item.name || item.description %></strong></td>
						</tr>
						<% if (item.name && item.description) { %>
						<tr class="item-row item-row--description"><td class="description-column" colspan="4"><div class="item-description"><%- nl2br(item.description) %></div></td></tr>
						<% } %>
						<% renderItems(item.items, depth + 1); %>
					<% } else { %>
						<tr style="border-bottom: 1px solid #eee;">
							<td style="padding: 8px 4px; padding-left: <%= depth * 16 %>px;"><strong><%= item.name || item.description %></strong></td>
							<td style="text-align: right; padding: 8px 4px;"><%= formatQuantity(item.quantity) %></td>
							<td style="padding: 8px 4px;"><%= item.unit %></td>
							<td style="text-align: right; padding: 8px 4px;"><%= formatMoney(item.unitPrice) %></td>
							<% if (!kleinunternehmer) { %><td style="text-align: right; padding: 8px 4px;"><%= item.taxRate %>%</td><% } %>
							<td style="text-align: right; padding: 8px 4px;"><%= formatMoney(computeItemSubtotal(item)) %></td>
						</tr>
						<% if (item.name && item.description) { %>
						<tr class="item-row item-row--description"><td class="description-column" colspan="4"><div class="item-description"><%- nl2br(item.description) %></div></td></tr>
						<% } %>
					<% } %>
				<% }); %>
			<% } %>
			<% renderItems(items, 0); %>
		</tbody>
	</table>

	<!-- Totals -->
	<div style="display: flex; justify-content: flex-end; margin-bottom: 30px;">
		<table style="min-width: 250px;">
			<tr><td style="padding: 4px 12px; color: #888;"><%= t('subtotal') %></td><td style="text-align: right; padding: 4px 0;"><%= formatMoney(totals.subtotal) %></td></tr>
			<% if (totals.discountAmount > 0) { %>
			<tr style="color: #c00;"><td style="padding: 4px 12px;"><%= t('discount') %></td><td style="text-align: right; padding: 4px 0;">-<%= formatMoney(totals.discountAmount) %></td></tr>
			<% } %>
			<% if (!kleinunternehmer) { %>
			<% totals.taxSubtotals.forEach(function(ts) { %>
			<tr><td style="padding: 4px 12px; color: #888;"><%= t('tax') %> <%= ts.rate %>%</td><td style="text-align: right; padding: 4px 0;"><%= formatMoney(ts.taxAmount) %></td></tr>
			<% }); %>
			<% } %>
			<% if (kleinunternehmerNotice) { %>
			<tr><td colspan="2" style="padding: 4px 12px; font-size: 8pt; color: #888;"><%= kleinunternehmerNotice %></td></tr>
			<% } %>
			<tr style="border-top: 2px solid #333; font-weight: 700; font-size: 12pt;">
				<td style="padding: 8px 12px;"><%= t('total') %></td>
				<td style="text-align: right; padding: 8px 0;"><%= formatMoney(totals.total) %></td>
			</tr>
		</table>
	</div>

	<!-- Payment instruction + Bank details -->
	<% if (seller.bankIban && type === 'invoice') { %>
	<div style="font-size: 8pt; color: #888; margin-bottom: 20px; padding: 12px; background: #f9f9f9; border-radius: 4px;">
		<div style="margin-bottom: 8px;"><%= t('paymentInstruction', { days: String(paymentTermDays) }) %></div>
		<strong><%= seller.bankAccount || seller.name %></strong><br>
		<%= seller.bankIban %>
		<% if (seller.bankSwift) { %><br><%= seller.bankSwift %><% } %>
	</div>
	<% } else if (seller.bankIban) { %>
	<div style="font-size: 8pt; color: #888; margin-bottom: 20px; padding: 12px; background: #f9f9f9; border-radius: 4px;">
		<strong><%= t('bankDetails') %></strong><br>
		<%= seller.bankName %> | IBAN: <%= seller.bankIban %>
		<% if (seller.bankSwift) { %> | BIC: <%= seller.bankSwift %><% } %>
	</div>
	<% } %>

	<!-- Payment QR Code -->
	<% if (typeof paymentQrCodeSvg !== 'undefined' && paymentQrCodeSvg) { %>
	<div style="text-align: center; margin-bottom: 20px;">
		<img src="<%= paymentQrCodeSvg %>" alt="Payment QR" style="max-width: 150px;">
		<div style="font-size: 7pt; color: #888; margin-top: 4px;"><%= t('paymentQrCode') %></div>
	</div>
	<% } %>

	<!-- Notes -->
	<% if (notes) { %>
	<div style="font-size: 9pt; color: #666; margin-bottom: 10px;"><%- nl2br(notes) %></div>
	<% } %>

	<!-- Footer -->
	<% if (footerText) { %>
	<div style="font-size: 8pt; color: #999; margin-top: auto; padding-top: 20px; border-top: 1px solid #eee;"><%- nl2br(footerText) %></div>
	<% } %>
</div>
